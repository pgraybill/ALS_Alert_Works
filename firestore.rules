rules_version = '2';

// Each signed-in account (the app and its ESP32, which signs in with the same
// email/password) can only read and write its own ALSAlert/{uid} document and
// its events. Cloud Functions use the Admin SDK and are not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /ALSAlert/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
