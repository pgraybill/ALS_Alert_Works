<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".calibrationFragment">

    <!-- TODO: Update blank fragment layout -->

    <TextView
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calibration Page"
        android:translationX="140dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:scrollbarStyle="insideInset"
        android:textAlignment="textStart"
        android:visibility="visible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textView18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibration Instructions \n1. Check that both electrodes are attached. \n2. Tap Start Calibration. \n3. Within a few seconds the device counts down on its screen. \n4. At GO, the patient looks left and right for 10 seconds. \n5. The device then goes back to monitoring. \nIf it alarms and shows Calibration Failed, press the red button and try again." />
    </ScrollView>

    <Button
        android:id="@+id/startCalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Calibration"
        android:translationX="140dp"
        android:translationY="600dp" />

</FrameLayout>